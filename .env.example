# ---- Dataset ----
# Folder that contains the HHGOA_IEEE files (transactions, identity, cases, policy docs...)
DATA_DIR=./data/HHGOA_IEEE

# ---- Graph backend ----
# tigergraph  -> all graph work goes through the TigerGraph MCP server (required for submission)
# local       -> in-process NetworkX/pandas mirror of the same queries (offline dev only)
GRAPH_BACKEND=tigergraph

# TigerGraph connection (read by both pyTigerGraph setup scripts and tigergraph-mcp)
TG_HOST=https://<your-instance>.i.tgcloud.io
TG_GRAPHNAME=FraudGraph
TG_USERNAME=tigergraph
TG_PASSWORD=
# Savanna: create a secret in the Admin Portal and put it here (preferred over password)
TG_SECRET=
TG_RESTPP_PORT=443
TG_GS_PORT=443

# ---- LLM ----
# Leave ANTHROPIC_API_KEY empty to run the deterministic planner only (no LLM narrative).
ANTHROPIC_API_KEY=
# model id from your LLM provider (required to enable the LLM agent loop)
LLM_MODEL=
LLM_EFFORT=medium

# ---- Agent ----
# How customer / step-up responses are obtained in batch runs: dataset | simulated | interactive
EVIDENCE_MODE=dataset
# OUTPUT_DIR defaults to outputs/hhgoa (real data) or outputs/synthetic
