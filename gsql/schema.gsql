// FraudGraph schema — transactions, entities, and the investigation (case) layer.
// Run with: python scripts/setup_graph.py --schema
USE GLOBAL

CREATE VERTEX Transaction (PRIMARY_ID txn_id STRING, ts INT, day INT, amount DOUBLE, product STRING,
    risk_score DOUBLE, proxy STRING, device_type STRING, dist1 DOUBLE) WITH primary_id_as_attribute="true"
CREATE VERTEX Customer (PRIMARY_ID customer_id STRING, first_day INT, n_txn INT, community INT DEFAULT -1,
    prior_fraud INT DEFAULT 0, prior_cleared INT DEFAULT 0) WITH primary_id_as_attribute="true"
CREATE VERTEX Card    (PRIMARY_ID card_key STRING, brand STRING, card_type STRING, degree INT DEFAULT 0) WITH primary_id_as_attribute="true"
CREATE VERTEX Device  (PRIMARY_ID device_key STRING, device_type STRING, degree INT DEFAULT 0) WITH primary_id_as_attribute="true"
CREATE VERTEX Network (PRIMARY_ID net_key STRING, degree INT DEFAULT 0) WITH primary_id_as_attribute="true"
CREATE VERTEX Email   (PRIMARY_ID domain STRING, degree INT DEFAULT 0) WITH primary_id_as_attribute="true"
CREATE VERTEX Address (PRIMARY_ID addr_key STRING, degree INT DEFAULT 0) WITH primary_id_as_attribute="true"

// investigation layer (case memory)
CREATE VERTEX FraudCase (PRIMARY_ID case_id STRING, status STRING, outcome STRING, fraud_type STRING,
    trigger_type STRING, risk DOUBLE, confidence DOUBLE, decision STRING, approval_route STRING,
    sar_required BOOL, summary STRING, opened_ts INT, updated_at STRING, is_benchmark BOOL,
    embedding LIST<DOUBLE>) WITH primary_id_as_attribute="true"
CREATE VERTEX CaseEvent (PRIMARY_ID event_id STRING, seq INT, kind STRING, detail STRING, at STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Pattern   (PRIMARY_ID name STRING, description STRING, documented BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX PolicyChunk (PRIMARY_ID chunk_id STRING, source STRING, heading STRING, text STRING,
    embedding LIST<DOUBLE>) WITH primary_id_as_attribute="true"

CREATE UNDIRECTED EDGE MADE        (FROM Customer, TO Transaction)
CREATE UNDIRECTED EDGE PAID_WITH   (FROM Transaction, TO Card)
CREATE UNDIRECTED EDGE USED_DEVICE (FROM Transaction, TO Device)
CREATE UNDIRECTED EDGE FROM_NETWORK(FROM Transaction, TO Network)
CREATE UNDIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO Email)
CREATE UNDIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO Email)
CREATE UNDIRECTED EDGE BILLED_TO   (FROM Transaction, TO Address)

CREATE UNDIRECTED EDGE CASE_TXN      (FROM FraudCase, TO Transaction, role STRING)
CREATE UNDIRECTED EDGE CASE_CUSTOMER (FROM FraudCase, TO Customer)
CREATE UNDIRECTED EDGE CASE_ENTITY_DEVICE (FROM FraudCase, TO Device)
CREATE UNDIRECTED EDGE CASE_ENTITY_CARD   (FROM FraudCase, TO Card)
CREATE DIRECTED   EDGE HAS_EVENT     (FROM FraudCase, TO CaseEvent)
CREATE UNDIRECTED EDGE MATCHES_PATTERN (FROM FraudCase, TO Pattern, confidence DOUBLE)
CREATE UNDIRECTED EDGE SIMILAR_TO    (FROM FraudCase, TO FraudCase, score DOUBLE)
CREATE UNDIRECTED EDGE DESCRIBED_BY  (FROM Pattern, TO PolicyChunk)

CREATE GRAPH FraudGraph (Transaction, Customer, Card, Device, Network, Email, Address,
    FraudCase, CaseEvent, Pattern, PolicyChunk,
    MADE, PAID_WITH, USED_DEVICE, FROM_NETWORK, PURCHASER_EMAIL, RECIPIENT_EMAIL, BILLED_TO,
    CASE_TXN, CASE_CUSTOMER, CASE_ENTITY_DEVICE, CASE_ENTITY_CARD, HAS_EVENT, MATCHES_PATTERN,
    SIMILAR_TO, DESCRIBED_BY)
